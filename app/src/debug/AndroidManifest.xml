<?xml version="1.0" encoding="utf-8"?>
<!-- Solo se mezcla con el manifest principal en la variante debug: aquí
     se permite tráfico HTTP sin cifrar (necesario para hablar con
     http://10.0.2.2:3000 u otra IP local en desarrollo). La variante
     release no toca esto, así que sigue exigiendo HTTPS. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
